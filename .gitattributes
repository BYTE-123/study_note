# 换行符策略：显式钉死，不依赖各人的 core.autocrlf 设置
* text=auto

# Linux shell 脚本必须是 LF —— CRLF 会导致 bash 报 $'\r': command not found
*.sh            text eol=lf

# Windows 批处理必须是 CRLF —— LF 会让 cmd.exe 解析异常（多行命令粘连）
*.bat           text eol=crlf

# 文本源码统一 LF
*.py            text eol=lf
*.md            text eol=lf
*.html          text eol=lf
*.css           text eol=lf
*.js            text eol=lf
*.txt           text eol=lf
*.example       text eol=lf
*.conf          text eol=lf
*.service       text eol=lf
